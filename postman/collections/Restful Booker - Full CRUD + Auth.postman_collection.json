                  "",
                  "pm.test('Response body is Created', () => {",
                  "    pm.expect(pm.response.text()).to.include('Created');",
                  "});",
                  "",
                  "pm.test('Clear created_booking_id from environment after deletion', () => {",
                  "    const deletedId = pm.environment.get('created_booking_id');",
                  "    pm.environment.set('deleted_booking_id', deletedId);",
                  "    pm.environment.set('created_booking_id', '');",
                  "    console.log('Deleted booking id:', deletedId, ' - cleared created_booking_id, saved to deleted_booking_id.');",
                  "    pm.expect(true).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{auth_token}}"
              }
